// Copy to Secrets.xcconfig (gitignored) and fill in - or let
// `deploy/obs-vps/gcp.sh companion` write it for you (VM must be running).
// Host only: "//" starts a comment in an xcconfig, so no https://.
LIVEVISION_HOST = 1-2-3-4.sslip.io
LIVEVISION_USER = clips
LIVEVISION_PASSWORD = paste-AUTOCLIP_PASSWORD
// Glasses -> VM ingest: STREAM_KEY and SRT_PASSPHRASE from deploy/obs-vps/.env
LIVEVISION_STREAM_KEY = paste-STREAM_KEY
LIVEVISION_SRT_PASSPHRASE = paste-SRT_PASSPHRASE

// Needed to install on a real iPhone (Xcode > Settings > Accounts):
// DEVELOPMENT_TEAM = ABCDE12345
// PRODUCT_BUNDLE_IDENTIFIER = com.yourname.livevision
