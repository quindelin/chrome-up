# --- runtime knobs --------------------------------------------------------------
# A long random string the phone app sends as its stream key. Treat this like a
# password. Generate one with:  openssl rand -hex 16
RTMP_STREAM_KEY=glasses-CHANGE-ME

# If you want the LLM clip agent instead of the offline heuristic:
AGENT_NAME=heuristic
# OPENAI_API_KEY=

# --- live multi-streaming -----------------------------------------------------
# Live re-broadcast targets. Set LIVE_STREAMS_ENABLED=1 and fill in the keys for
# the platforms you want to be able to go live on by voice. Only platforms with a
# key set will accept a start command; the rest report "missing stream key".
LIVE_STREAMS_ENABLED=0
# YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx
# TWITCH_STREAM_KEY=live_000000000_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KICK_STREAM_KEY=
# X_STREAM_KEY=
# FACEBOOK_STREAM_KEY=
# INSTAGRAM_STREAM_KEY=

# Publishing to socials
PUBLISH_MODE=dry_run         # dry_run | live
# YOUTUBE_CLIENT_SECRETS=
# YOUTUBE_CREDENTIALS=
# INSTAGRAM_ACCESS_TOKEN=
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# REST + MCP server (optional, off by default)
AUTOCLIP_SERVE=0
AUTOCLIP_PORT=8899
# AUTOCLIP_API_TOKEN=
