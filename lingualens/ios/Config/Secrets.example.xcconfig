// Copy to Secrets.xcconfig (gitignored) and fill in.
// `./deploy/lingualens/deploy.sh url` prints the host and key.
// Host only: "//" starts a comment in an xcconfig, so no https://.
LL_SERVER_HOST = lingualens-xxxxxxxxxx-uc.a.run.app
LL_SERVER_KEY = paste-the-key
LL_CLIENT_ID = me

// Needed to install on a real iPhone (Xcode > Settings > Accounts):
// DEVELOPMENT_TEAM = ABCDE12345
// PRODUCT_BUNDLE_IDENTIFIER = com.yourname.lingualens

// From the Wearables Developer Center, once you leave DAT Developer Mode:
// META_APP_ID = 0
// META_CLIENT_TOKEN = 0
